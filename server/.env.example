# Leave GROK_API_KEY empty to run in DEMO MODE (no AI, pattern matching only).
# Add a real xAI key (starts with xai-) and restart the server to switch to Grok.
GROK_API_KEY=
# Any tool-calling Grok model works. Change it here if xAI renames or retires this one.
GROK_MODEL=grok-4-1-fast-non-reasoning
PORT=3001
# Set to true to force demo mode even when a key is present (handy if venue Wi-Fi is bad).
DEMO_MODE=false
